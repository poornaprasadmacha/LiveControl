# Security PIN for Admin Session creation & authentication
ADMIN_PIN=change-this-pin

# Frontend URL for Backend Socket.IO CORS configuration
FRONTEND_URL=http://localhost:3000

# Backend Socket.IO Server URL for Frontend connection
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:3001

# Session auto-deletion safety configuration
ROOM_EXPIRATION_MINUTES=120
AUTO_DELETE_ENABLED=true
